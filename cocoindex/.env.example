# このファイルを `.env` にコピーし、機種ごとの projects ディレクトリ絶対パスを設定する。
# `.env` は git 管理外(機種固有のため)。
#
#   cp .env.example .env
#
# 例) Mac 上 OrbStack Ubuntu:
#   COCOINDEX_PROJECTS_DIR=/mnt/mac/Users/akihiro.higashiizumi/projects
# 例) 実機 Ubuntu:
#   COCOINDEX_PROJECTS_DIR=/home/<user>/projects
COCOINDEX_PROJECTS_DIR=
