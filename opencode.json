{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "server": {
    "hostname": "0.0.0.0"
  },
  "tools": {
    "write": true,
    "bash": true,
    "webfetch": true
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff": "allow",
      "git add": "allow",
      "git commit": "allow",
      "git push": "ask",
      "git log": "allow",
      "ls": "allow",
      "cat": "allow",
      "pwd": "allow",
      "rg": "allow",
      "go build": "allow",
      "go test": "allow",
      "go mod tidy": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true,
      "environment": {}
    },
    "dailymemo": {
      "type": "local",
      "command": [
        "node",
        "/Users/akihiro/code/dailymemo/mcp-server/dist/index.js"
      ],
      "enabled": true,
      "environment": {
        "DAILYMEMO_PATH": "/Users/akihiro/code/dailymemo"
      }
    }
  },
  "agent": {
    "plan": {
      "tools": {
        "write": false,
        "bash": false
      }
    }
  }
}
