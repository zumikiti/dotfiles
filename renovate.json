{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Flox manifest version manager",
      "fileMatch": ["^\.flox/env/manifest\.toml$"],
      "matchStrings": [
        "(?<depName>[^\s.]+)\.version = \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Fish plugins manager",
      "fileMatch": ["^fish/fish_plugins$"],
      "matchStrings": [
        "^([^\s]+)$"
      ],
      "depNameTemplate": "fisher/{{{currentValue}}}",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["neovim"],
      "enabled": false 
    }
  ]
}
