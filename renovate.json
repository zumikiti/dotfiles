{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "customManagers:githubActionsVersions"],
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "node-version は renovate の engines.node に合わせて手で上げる。major の自動提案は無効",
      "matchDepNames": ["node"],
      "matchFileNames": [".github/workflows/renovate-config.yml"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "GitHub Actions の浮動メジャータグ（v4 等）の digest 更新は PR のチェック成功後に Renovate 自身がマージする。完全一致タグ（v4.3.1 等）の digest 変更は上流のタグ付け替えなので対象外。fisher プラグインは git-refs で上流 HEAD を追い、CI でも検証されないため手動レビュー。minor / major も手動",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "matchCurrentValue": "/^v\\d+$/",
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "fisher plugins pinned by commit SHA (owner/repo@<sha40>)",
      "managerFilePatterns": ["/^fish/fish_plugins$/"],
      "matchStrings": ["(?<depName>[\\w.-]+/[\\w.-]+)@(?<currentDigest>[0-9a-f]{40})"],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    }
  ]
}
